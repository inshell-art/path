{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inshell.thought.deployment.receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaignId", "phase", "environment", "chainId", "status", "consumedPathPhaseAReceiptSha256", "consumedPathPhaseA", "pathNft", "thoughtRelease", "bundleDigest", "contracts", "deployments", "registry", "compatibility", "authorities", "approvedPathIntegration", "pathMutationPerformed", "pathMutationOwner", "verification"],
  "properties": {
    "schema": { "const": "inshell.thought.deployment.receipt.v1" },
    "campaignId": { "type": "string", "minLength": 1 },
    "phase": { "const": "thought" },
    "environment": { "enum": ["internal-sepolia", "public-beta-sepolia", "mainnet"] },
    "chainId": { "type": "integer", "minimum": 1 },
    "status": { "const": "complete" },
    "consumedPathPhaseAReceiptSha256": { "$ref": "#/$defs/hash" },
    "consumedPathPhaseA": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelopeSha256", "payloadSha256"],
      "properties": {
        "envelopeSha256": { "$ref": "#/$defs/hash" },
        "payloadSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "pathNft": { "$ref": "#/$defs/address" },
    "thoughtRelease": { "type": "object", "required": ["artifactId", "manifestSha256", "publicationCommit", "sourceTag"] },
    "bundleDigest": { "$ref": "#/$defs/bytes32" },
    "contracts": { "type": "object", "required": ["thoughtSpecRegistry", "protocolRegistry", "glyphDataPointer", "thoughtRenderer", "creationAttestationVerifier", "thoughtNft"] },
    "deployments": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "object", "required": ["name", "address", "transaction", "block", "creationBytecodeHash", "runtimeBytecodeHash"] }
    },
    "registry": { "type": "object", "required": ["thoughtSpecId", "thoughtSpecHash", "protocolReleaseId", "protocolManifestHash", "exactBytesVerified"] },
    "compatibility": { "type": "object", "required": ["pathNftImmutable", "rendererIdHash", "metadataProfileIdHash", "workProfileIdHash", "contextProfileIdHash", "creationAttestationProfileId"] },
    "authorities": { "type": "object", "required": ["registryOwner", "protocolRegistryOwner", "attestationVerifierOwner", "attestationAuthority", "attestationAuthorityEpoch"] },
    "approvedPathIntegration": { "type": "object", "required": ["movement", "quota", "thoughtNft"] },
    "pathMutationPerformed": { "const": false },
    "pathMutationOwner": { "const": "PATH_PHASE_B" },
    "verification": { "type": "object", "required": ["overall", "registry", "immutableDependencies", "profiles"] }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
